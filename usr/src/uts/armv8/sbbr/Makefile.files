#
#	Global definitions for armv8 sbbr implementation specific modules.
#

#
# Define objects.
#
CORE_OBJS_SBBR +=		\
	prom_emul_sbbr.o	\
	acpi_stubs.o

SBBR_PLATMOD_OBJS = sbbr.o

#
#	include sbbr header files
#
INC_PATH	+= -I$(UTSBASE)/armv8 -I$(UTSBASE)/armv8/sbbr
